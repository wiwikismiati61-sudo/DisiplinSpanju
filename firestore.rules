rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: students, violations, consequences, followups, transactions, homeroomTeachers, counselors
    // All documents have a structure defined in firebase-blueprint.json
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = exists(/databases/$(database)/documents/users/$(request.auth.token.email)) ? 
                    get(/databases/$(database)/documents/users/$(request.auth.token.email)) : null;
      return userDoc != null ? userDoc.data.role : 'viewer';
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "wiwikismiati61@guru.smp.belajar.id" && request.auth.token.email_verified == true) ||
         getUserRole() == 'admin');
    }

    function isEditor() {
      return isAuthenticated() &&
        (isAdmin() || getUserRole() == 'editor');
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Allow anyone to read data (for dashboard and reports)
    match /students/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /violations/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /consequences/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /followups/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /transactions/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /homeroomTeachers/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }
    match /counselors/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // User profiles (for role management)
    match /users/{userEmail} {
      allow read: if isAuthenticated() && (request.auth.token.email == userEmail || isAdmin());
      allow write: if isAdmin();
    }

    // User secrets (for password management)
    match /user_secrets/{userId} {
      allow read, write: if isAdmin();
    }

    // Credentials collection (legacy)
    match /credentials/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
